# =============================================================================
# Agentic Orchestrator - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Application ---
APP_NAME=agentic-orchestrator
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_URL=http://${CHROMA_HOST}:${CHROMA_PORT}

# --- Security ---
JWT_SECRET=replace-with-a-256-bit-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
API_RATE_LIMIT=100

# --- LLM (optional, for enhanced planning) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTEL_SERVICE_NAME=agentic-orchestrator
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# --- Simulator ---
SIMULATOR_DEFAULT_SEED=42
SIMULATOR_FAILURE_RATE=0.1
SIMULATOR_LATENCY_MEAN=0.5
SIMULATOR_LATENCY_STD=0.2

# --- Replay UI ---
STREAMLIT_PORT=8501

# --- Model Training ---
TRAINING_EPISODES=1000
TRAINING_GAMMA=0.99
TRAINING_LR=0.001
